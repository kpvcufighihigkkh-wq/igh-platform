FROM golang:1.22-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/igh-server ./cmd/server

FROM alpine:3.19
RUN apk add --no-cache tzdata
COPY --from=builder /bin/igh-server /app/igh-server
WORKDIR /app
ENTRYPOINT ["/app/igh-server"]
