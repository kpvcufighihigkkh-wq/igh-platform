FROM golang:1.22-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -o /bin/igh-edge.exe ./cmd/edge

FROM alpine:3.19
COPY --from=builder /bin/igh-edge.exe /app/igh-edge.exe
WORKDIR /app
ENTRYPOINT ["/app/igh-edge.exe"]
