# Binaries
bin/
*.exe
*.dll
*.so
*.dylib

# Go
vendor/

# Frontend
web/node_modules/
web/dist/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Environment
.env
*.local

# Logs
logs/
*.log

# Build
tmp/

# Go workspace (local only)
go.work
go.work.sum

# Test results
web/test-results/

# Data
data/
# 边端本地库（SQLite）：运行时产物，含现场数据，不入库。
# 配置目录随机器不同（data-winding / data3 …），按模式忽略。
data-*/
data3/

# 前端构建产物：由 web-build / npm run build 生成，不入库。
# 源码在 web/src；构建文件名带哈希，入库只会制造无意义 diff。
configs/ui/
configs-dev3/ui/
internal/edge/app/dist/*
# 边端 //go:embed all:dist 要求目录存在，保留占位文件
!internal/edge/app/dist/.gitkeep

# 旧系统资料（O17004 / O17006 的日志与源码快照）。
# 只用于开发期核对字段与点表来源，不属于新系统，也不被任何代码引用。
legacy/

# Claude Code 本地设置：含本机绝对路径与调用记录，属于个人环境配置。
.claude/
