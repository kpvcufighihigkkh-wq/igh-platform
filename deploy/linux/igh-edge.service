[Unit]
Description=IGH Platform Edge Node
Documentation=https://github.com/kpvcufighihigkkh-wq/igh-platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=igh
Group=igh
WorkingDirectory=/opt/igh-edge
ExecStart=/opt/igh-edge/igh-edge --config /opt/igh-edge
Restart=always
RestartSec=5
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/igh-edge/data
PrivateTmp=true

# Environment
Environment=GIN_MODE=release

[Install]
WantedBy=multi-user.target
