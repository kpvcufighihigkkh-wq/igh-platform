{
  "name": "igh-platform-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "e2e:prepare": "node e2e/prepare-edges.mjs",
    "e2e:center-config": "node e2e/prepare-center.mjs",
    "e2e": "npm run e2e:prepare && cd .. && go build -o bin/igh-edge-e2e.exe ./cmd/edge && cd web && playwright test",
    "e2e:edge": "playwright test --project=edge"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.12.0",
    "axios": "^1.6.0",
    "echarts": "^5.5.0",
    "naive-ui": "^2.38.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.0"
  }
}
